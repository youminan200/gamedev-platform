{
  "expo": {
    "name": "DevGround",
    "slug": "expo-client",
    "scheme": "devground",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anwinmin01.expoclient",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.anwinmin01.expoclient",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "name": "DevGround - 게임 개발자 커뮤니티",
      "shortName": "DevGround",
      "description": "인디 게임 개발자들의 개발일지(DevLog) 및 에셋 공유 플랫폼",
      "themeColor": "#E0E5EC",
      "backgroundColor": "#E0E5EC",
      "display": "standalone",
      "icon": "./assets/icon.png",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "203e07bd-49c8-4930-9a76-77a78a35c348"
      }
    }
  }
}
